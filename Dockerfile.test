# Dockerfile for running all tests in a container
FROM node:22-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install git and bash (needed for workspace protocol and some tests)
RUN apk add --no-cache git bash

WORKDIR /optio

# Copy package files first for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/cli/package.json ./apps/cli/
COPY apps/site/package.json ./apps/site/
COPY packages/shared/package.json ./packages/shared/
COPY packages/agent-adapters/package.json ./packages/agent-adapters/
COPY packages/container-runtime/package.json ./packages/container-runtime/
COPY packages/ticket-providers/package.json ./packages/ticket-providers/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build shared packages first
RUN pnpm --filter @optio/shared build
RUN pnpm --filter @optio/ticket-providers build
RUN pnpm --filter @optio/container-runtime build

# Default command runs all tests
CMD ["sh", "-c", "pnpm format:check && pnpm turbo typecheck && pnpm turbo test"]